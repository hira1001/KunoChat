{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main KunoChat window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "opener:default",
    "notification:default",
    "global-shortcut:default",
    "clipboard-manager:default",
    "autostart:default",
    "store:default",
    "sql:default",
    "window-state:default",
    "updater:default",
    "process:allow-restart"
  ]
}
