{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KunoChat",
  "version": "0.1.0",
  "identifier": "com.kunochat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KunoChat",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "KunoChat",
    "copyright": "Copyright KunoChat",
    "category": "Productivity",
    "shortDescription": "A tiny desktop send pocket for two people.",
    "longDescription": "KunoChat is a minimal Windows and macOS desktop chat and file handoff app."
  }
}
