{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KunoChat",
  "version": "0.3.6",
  "identifier": "com.kunochat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KunoChat",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self' blob: data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMEU4NUE3QTkwNEM5ClJXVEpCS21uaFE2dEFOS3Q1WGNCdVJxbk1weXNxSWZmK3lmVTNKUWJiV01QM3VhaHk3UzFJejVjCg==",
      "endpoints": [
        "https://github.com/hira1001/KunoChat/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "KunoChat",
    "copyright": "Copyright KunoChat",
    "category": "Productivity",
    "shortDescription": "A tiny desktop send pocket for two people.",
    "longDescription": "KunoChat is a minimal Windows and macOS desktop chat and file handoff app."
  }
}
